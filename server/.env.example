PORT=4000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://automation-crm.netlify.app,http://localhost:5173
LOGIN_RATE_LIMIT_MAX=50
RESET_RATE_LIMIT_MAX=10
# Set to "true" to skip the simulated 300-1200ms latency (useful for fast local iteration).
DISABLE_LATENCY=false
ANALYSIS_GITHUB_REPOSITORY=deven037/crm-data-science-lab
ANALYSIS_GITHUB_REF=main
ANALYSIS_GITHUB_TOKEN=
ANALYSIS_WORKFLOW_SECRET=
PUBLIC_API_URL=https://crm-practice-api.onrender.com

# --- CRM 3.0 ---
# PostgreSQL connection string (Neon free tier). Leave empty for local development:
# the API then uses PGlite and keeps its files in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
BCRYPT_ROUNDS=10
# Platform owner sign-in for the platform console. Leave both empty to disable it.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# false closes the demo bank's open reset and forgot-password routes.
DEMO_OPEN_ROUTES=true
REGISTER_RATE_LIMIT_MAX=10
